{
  "name": "strandcue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "react-native": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "uuid": "11.1.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:domain": "tsc --noEmit",
    "typecheck": "npm run typecheck:domain && npm run typecheck --workspace @strandcue/mobile",
    "export:web": "npm run export:web --workspace @strandcue/mobile",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:control-plane": "node scripts/audit-cli.ts",
    "verify": "npm run typecheck && npm test && npm run audit:control-plane && npm run export:web",
    "mobile": "npm run start --workspace @strandcue/mobile"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.0",
    "jest-validate": "29.7.0",
    "react-native": "0.86.3",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "zod": "4.5.4"
  }
}
