{
  "name": "strandcue-website",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "strandcue.co.za/*", "zone_name": "strandcue.co.za" }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
