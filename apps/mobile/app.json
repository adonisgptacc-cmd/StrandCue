{
  "expo": {
    "name": "StrandCue", "slug": "strandcue", "scheme": "strandcue", "version": "0.1.0",
    "orientation": "portrait", "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF2E6"
    },
    "platforms": ["android", "web"],
    "ios": {"supportsTablet": true},
    "android": {
      "package": "za.co.strandcue.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#63295E"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "strandcue.adonisgptacc.workers.dev",
              "pathPrefix": "/auth/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {"bundler": "metro", "output": "single", "favicon": "./assets/brand/icon.png"},
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {"eas": {"projectId": "de98e7bc-f21a-452b-a87c-18bfe2c8e9e6"}}
  }
}
