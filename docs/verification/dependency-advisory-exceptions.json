    "severity": "moderate",
    "reachable": "no",
    "assessment": "npm audit emits the affected uuid leaf path plus derived paths that enter it through Expo's xcode configuration tooling. Ten signatures rooted at the direct Expo application dependency are conservatively classified across Android, web, production, and iOS build tooling; the remaining fifteen signatures are iOS build tooling only. The affected UUID call remains in iOS configuration code rather than the Android or web application runtime.",
    "mitigation": "Phase 1 excludes the affected iOS configuration path; this scope boundary limits current reachability but is not a dependency fix.",
    "owner": "StrandCue maintainer",
    "approvedOn": "2026-10-06",
    "reviewOn": "2026-11-05",
    "expiresOn": "2026-12-05",
    "upgradePath": "Upgrade Expo's xcode tooling to a compatible release using a fixed uuid version, then remove this exception."
  },
